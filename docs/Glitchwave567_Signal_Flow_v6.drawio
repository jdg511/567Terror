<mxfile host="Electron" agent="Claude">
  <diagram name="1 - Audio Path" id="gwHwAudioV6">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3700" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="a-title" parent="1" vertex="1" value="GLITCHWAVE 567 &#8212; MAIN BOARD HARDWARE SIGNAL FLOW  (rev 6, from the fabbed schematic)&#xa;Page 1 of 4: the audio path. Every knob is an OTA VCA driven by a Pico PWM CV &#8212; no audio ever touches the MCU." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;">
          <mxGeometry x="40" y="30" width="1600" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a-legend" parent="1" vertex="1" value="Blue = op-amp / passive audio  &#183;  Green = wet (567)  &#183;  Orange = dry (Bazz Fuss)  &#183;  Purple = CV from the Pico  &#183;  Red = switch or DO-NOT-FIT  &#183;  Yellow = jacks and rails" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;">
          <mxGeometry x="40" y="105" width="1600" height="30" as="geometry" />
        </mxCell>

        <!-- ============ input ============ -->
        <mxCell id="a-j1" parent="1" vertex="1" value="J1  INPUT JACK&#xa;6.35 mm PJ-603A&#xa;switched tip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;">
          <mxGeometry x="40" y="400" width="180" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-innet" parent="1" vertex="1" value="INPUT NETWORK  (original, faithful)&#xa;R1 1k series &#183; R2 2.2M load&#xa;C1 220n block &#183; R3 2.2M bias to VREF&#xa;&#8594; U1A buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="260" y="400" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-voice" parent="1" vertex="1" value="VOICING LOW-CUT&#xa;2&#215; Sallen-Key HP, 24 dB/oct @ 40 Hz&#xa;Q 0.54 then Q 1.31" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="590" y="400" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-tap" parent="1" vertex="1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;">
          <mxGeometry x="915" y="452" width="16" height="16" as="geometry" />
        </mxCell>

        <mxCell id="a-taplbl" parent="1" vertex="1" value="DRY_CLEAN&#xa;tap is AFTER the voicing filter&#xa;(also feeds the bypass VCA on this page&#xa;and the envelope follower on page 3)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;">
          <mxGeometry x="800" y="490" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- ============ wet branch ============ -->
        <mxCell id="a-trim" parent="1" vertex="1" value="FIXED TRIM&#xa;+15 dB&#xa;wet branch only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1000" y="180" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-gain" parent="1" vertex="1" value="GAIN STAGE  U1&#xa;&#215;214.6  (1 + 470k / 2.2k)&#xa;C2 4.7&#181; shelf, unity below 15.4 Hz&#xa;CLIPS THE RAILS &#8594; square into the 567" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1220" y="180" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-567" parent="1" vertex="1" value="U5  LM567  TONE DECODER&#xa;SO-8, on the V567 rail&#xa;THE HEART&#xa;&#8594; detail on page 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="1570" y="165" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="a-dnp" parent="1" vertex="1" value="C41 / C42  &#8212;  DO NOT FIT&#xa;LFIL (pin 2) and OFIL (pin 1) pads are&#xa;deliberately EMPTY. With no filter caps the&#xa;loop never settles and pin 8 chatters at&#xa;audio rate. THAT CHATTER IS THE VOICE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;">
          <mxGeometry x="1560" y="10" width="320" height="130" as="geometry" />
        </mxCell>

        <mxCell id="a-freqota" parent="1" vertex="1" value="U7  LM13700 OTA&#xa;emulates the timing resistor RT&#xa;pin 5 square &#8594; attenuator &#8594; OTA&#xa;&#8594; current into the CT node&#xa;R38 100k floor keeps the VCO alive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1450" y="370" width="290" height="130" as="geometry" />
        </mxCell>

        <mxCell id="a-ctmux" parent="1" vertex="1" value="U8  CD4052B&#xa;CT RANGE SELECT&#xa;47n / 1&#181; / 22&#181; / 470&#181;&#xa;&#215; OTA sweep = 0.2 Hz &#8230; 6 kHz+" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1780" y="370" width="270" height="130" as="geometry" />
        </mxCell>

        <mxCell id="a-freqcv" parent="1" vertex="1" value="FREQ_CV  (Iabc)&#xa;FREQ_A / FREQ_B  (range)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="1560" y="540" width="380" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a-q" parent="1" vertex="1" value="Q OPEN-COLLECTOR NODE  (pin 8)&#xa;R16 100k weak pull-up to V567&#xa;C43 makes the stray C explicit&#xa;&#8594; lopsided square, original behaviour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1930" y="175" width="300" height="120" as="geometry" />
        </mxCell>

        <!-- ============ dry branch ============ -->
        <mxCell id="a-dirtvca" parent="1" vertex="1" value="DIRT GAIN VCA  U3 LM13700&#xa;&#215;1 &#8230; &#215;300 sweep&#xa;(VCA attenuator + fixed &#215;300 stage)&#xa;replaces a digipot: 5 V parts cannot&#xa;pass 9 V-referenced audio at 18 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1000" y="650" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="a-dirtcv" parent="1" vertex="1" value="DIRT_CV  (Iabc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="1060" y="810" width="180" height="45" as="geometry" />
        </mxCell>

        <mxCell id="a-bazz" parent="1" vertex="1" value="BAZZ FUSS  (always on, dry path)&#xa;Q1 MMBTA13 darlington + D1 diode&#xa;collector rail = VDIRT (the starve target)&#xa;9 kHz voicing LP &#183; DC-blocked out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1350" y="650" width="320" height="140" as="geometry" />
        </mxCell>

        <!-- ============ mix ============ -->
        <mxCell id="a-wetvca" parent="1" vertex="1" value="WET VCA  U10A&#xa;raw 567 square" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="2320" y="180" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-wetcv" parent="1" vertex="1" value="MIX_WET_CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="2355" y="310" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a-dryvca" parent="1" vertex="1" value="DRY VCA  U10B&#xa;Bazz Fuss output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="2320" y="665" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-drycv" parent="1" vertex="1" value="MIX_DRY_CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="2355" y="795" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a-sum" parent="1" vertex="1" value="U9A  VIRTUAL-GROUND SUM&#xa;the two VCA output CURRENTS sum here&#xa;(free mixing &#8212; no crossfade pot)&#xa;original R9 1M wet / R10 100k dry / R11 100k fb&#xa;reproduced by input attenuators + firmware CV law" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="2620" y="390" width="330" height="150" as="geometry" />
        </mxCell>

        <mxCell id="a-svf" parent="1" vertex="1" value="STATE-VARIABLE FILTER&#xa;LM13700 datasheet topology&#xa;U9B sum &#8594; U11A int1 (BP) &#8594; U11B int2 (LP)&#xa;HP taken at the sum node&#xa;cutoff: SVF_F_CV &#8594; both Iabc&#xa;Q: BP feedback through U12A VCA, 0.25 &#8230; 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="3010" y="380" width="340" height="170" as="geometry" />
        </mxCell>

        <mxCell id="a-svfcv" parent="1" vertex="1" value="SVF_F_CV  &#183;  SVF_Q_CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="3070" y="570" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="a-fmode" parent="1" vertex="1" value="U13  CD4051B&#xa;MODE SELECT&#xa;ch0 Off (bypass) &#183; ch1 LP&#xa;ch2 BP &#183; ch3 HP &#183; ch4 Notch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="3410" y="390" width="250" height="150" as="geometry" />
        </mxCell>

        <mxCell id="a-fmodecv" parent="1" vertex="1" value="FMODE_A / B / C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="3450" y="570" width="170" height="45" as="geometry" />
        </mxCell>

        <!-- ============ output chain (wrapped row) ============ -->
        <mxCell id="a-dcblk" parent="1" vertex="1" value="C8 / R12 DC BLOCK&#xa;7.2 Hz (original)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="40" y="1010" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-hp60" parent="1" vertex="1" value="HP 60 Hz&#xa;12 dB/oct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="300" y="1010" width="170" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-bell" parent="1" vertex="1" value="BELL +3 dB @ 800 Hz&#xa;Q 0.5 &#183; Zf 3.6k||56n, Zg 4.3k+47n&#xa;review-verified 790 Hz / +3.04 dB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="510" y="1010" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-sw1" parent="1" vertex="1" value="SW1  +6 dB&#xa;MSK-12C02 slide&#xa;short = unity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="830" y="1010" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-sw2" parent="1" vertex="1" value="SW2  JFET STAGE&#xa;QJ1 MMBFJ201 Fetzer Valve&#xa;big 2nd harmonic, asym squish&#xa;SHIPS IN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1050" y="1010" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-sw3" parent="1" vertex="1" value="SW3  &#8722;3/&#8722;6 ASYM LADDER&#xa;D70&#8211;D75 1N4148W&#xa;pos half soft 3-step, neg half 2-step&#xa;SHIPS OUT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1350" y="1010" width="290" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-gatevca" parent="1" vertex="1" value="U15A  GATE &#215; VOL VCA&#xa;one VCA, product CV from the Pico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1690" y="1010" width="270" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-gatecv" parent="1" vertex="1" value="GATE_VOL_CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="1740" y="940" width="170" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a-bypvca" parent="1" vertex="1" value="U15B  CLEAN-BYPASS VCA&#xa;fed from DRY_CLEAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1690" y="1250" width="270" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-bypcv" parent="1" vertex="1" value="BYPASS_CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="1740" y="1385" width="170" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a-dryin" parent="1" vertex="1" value="DRY_CLEAN&#xa;(global label, from the input tap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="1390" y="1265" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a-obuf" parent="1" vertex="1" value="U16A  SUM + BUFFER&#xa;U15A and U15B output CURRENTS&#xa;sum here (ERC output-output waiver)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="2010" y="1125" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-r13" parent="1" vertex="1" value="R13&#xa;470R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="2360" y="1130" width="120" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-j2" parent="1" vertex="1" value="J2  OUTPUT JACK&#xa;6.35 mm PJ-603A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;">
          <mxGeometry x="2530" y="1130" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-note" parent="1" vertex="1" value="WHY THERE ARE NO AUDIO POTS ON THIS BOARD&#xa;&#xa;Every control is an OTA VCA or an analog mux, steered by a filtered PWM CV from the Pico. The six panel pots on the control board are&#xa;DC wipers into the ADC mux &#8212; audio never leaves the analog domain and never crosses the 2x8 header. That is what makes the pedal&#xa;digitally controlled rather than digital: the Pico sets currents, the LM13700s do the work." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=12;">
          <mxGeometry x="2530" y="1290" width="1130" height="180" as="geometry" />
        </mxCell>

        <!-- ============ edges ============ -->
        <mxCell id="ae1" parent="1" edge="1" source="a-j1" target="a-innet" value="IN_TIP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" parent="1" edge="1" source="a-innet" target="a-voice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" parent="1" edge="1" source="a-voice" target="a-tap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;endArrow=none;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae4" parent="1" edge="1" source="a-tap" target="a-trim" value="V567_DRIVE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;strokeColor=#82b366;fontSize=11;fontColor=#82b366;"><mxGeometry relative="1" as="geometry" /></mxCell>
