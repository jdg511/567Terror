        <mxCell id="ae9" parent="1" edge="1" source="a-gain" target="a-567" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;strokeColor=#82b366;"><mxGeometry relative="1" as="geometry" /></mxCell>
