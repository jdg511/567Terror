  <diagram name="2 - LM567 Core" id="gwHwCoreV7">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="k-title" parent="1" vertex="1" value="PAGE 2 &#183; THE 567 CORE&#xa;How a fixed-frequency tone decoder gets a 0.2 Hz to 6 kHz sweep: an OTA stands in for the timing resistor and a 4052 switches the timing cap." style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;">
          <mxGeometry x="40" y="30" width="1600" height="66" as="geometry" />
        </mxCell>

        <mxCell id="k-sw" parent="1" vertex="1" value="REV 7: C41 AND C42 ARE NOW SWITCHED, NOT DNP&#xa;&#xa;SW2  C41 1&#181; on LFIL (pin 2)&#xa;SW3  C42 220n on OFIL (pin 1)&#xa;BOTH SHIP OFF. Empty is still the voice.&#xa;(SW1 is the JFET in/out switch, page 1.)&#xa;&#xa;Switch on the GROUND side of the cap, never between&#xa;the cap and the pin: LFIL and OFIL are high impedance&#xa;and a stub off the pin adds stray C to the very node you&#xa;are trying to leave alone. Put ~1M across each switch so&#xa;the floating plate cannot drift and thump on the flip." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="60" y="120" width="460" height="290" as="geometry" />
        </mxCell>

        <mxCell id="k-drive" parent="1" vertex="1" value="V567_DRIVE&#xa;clipped square from the&#xa;&#215;214.6 gain stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="40" y="490" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="k-567" parent="1" vertex="1" value="U5  LM567  (SO-8)&#xa;&#xa;pin 3  input&#xa;pin 5 / 6  timing (RT, CT)&#xa;pin 1  OFIL &#183; pin 2  LFIL&#xa;pin 8  Q open collector&#xa;&#xa;rev 7 rail: straight off VA through a divider,&#xa;8.7 V max (page 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="640" y="390" width="360" height="300" as="geometry" />
        </mxCell>

        <mxCell id="k-ota" parent="1" vertex="1" value="U7  LM13700 OTA  &#183;  ELECTRONIC RT&#xa;pin 5 square, attenuator, OTA,&#xa;current into the CT node&#xa;Iabc = FREQ_CV sweeps f0 over decades&#xa;R38 100k floor keeps the VCO alive at Iabc = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="600" y="800" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="k-ct" parent="1" vertex="1" value="U8  CD4052B  &#183;  CT RANGE SELECT&#xa;on the V567 rail, picks 1 of 4 caps&#xa;47n  /  1&#181;  /  22&#181;  /  470&#181;&#xa;with the OTA sweep: 0.2 Hz to 6 kHz+ with overlap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1120" y="800" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="k-shift" parent="1" vertex="1" value="Q2 / Q3  MMBT3904&#xa;LEVEL SHIFT 3.3 V to V567&#xa;INVERTING, firmware flips the bits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1180" y="1040" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="k-freqcv" parent="1" vertex="1" value="FREQ_CV&#xa;Pico PWM, 2-pole RC&#xa;(pitch is the most FM-audible CV,&#xa;so it gets the extra pole)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="100" y="820" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="k-freqab" parent="1" vertex="1" value="FREQ_A / FREQ_B&#xa;Pico GP, range select" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1650" y="1060" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="k-q" parent="1" vertex="1" value="Q NODE  (pin 8)&#xa;R16 100k weak pull-up to V567&#xa;C43 = the sim&#39;s stray C, made explicit&#xa;weak pull-up gives a lopsided square,&#xa;which is the original behaviour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1330" y="440" width="340" height="150" as="geometry" />
        </mxCell>

        <mxCell id="k-qout" parent="1" vertex="1" value="Q_OUT&#xa;to the WET VCA (page 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1800" y="340" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="k-lock" parent="1" vertex="1" value="LOCK_SENSE&#xa;to ADC mux ch8 (page 3)&#xa;firmware can see whether it locked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1800" y="580" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="k-cal" parent="1" vertex="1" value="THE TWO CAVEATS, PROPERLY&#xa;&#xa;1.  R38 IS OUTSIDE THE DOCUMENTED RT RANGE.  TI characterises the 567 with a timing resistor between 2k and 20k, and every number they publish for f0 accuracy&#xa;and drift assumes you are in that window. R38 is 100k, five times past the top. It is only there as a FLOOR: when the OTA is turned fully off, R38 alone keeps the VCO&#xa;running at the very bottom of the sweep instead of stalling. So the part of the range where the chip is unspecified is the part where you are already at 0.2 Hz and&#xa;cannot hear pitch anyway. It is an accepted unknown, not a risk, because nothing musical depends on f0 being accurate down there.&#xa;&#xa;2.  THE 4052 rON ADDS A TIMING ERROR.  The timing cap is not wired to the 567 directly, it goes through an analog switch, and a CD4052B channel has roughly 100 to&#xa;300 ohms of on-resistance depending on rail and temperature. That resistance sits in series with CT, so the chip does not see the RC you designed, it sees RC plus a bit.&#xa;The error scales as about 3.6 &#215; rON / Reff, so it is negligible on the 470&#181; range where Reff is large, and it grows as you move to the 47n range where Reff is only a&#xa;few k. Two consequences: f0 reads slightly low at the top of the sweep, and because rON drifts with temperature the error drifts too. Firmware calibrates it out per&#xa;range, which is why each of the four CT positions gets its own correction rather than one global fudge factor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=12;">
          <mxGeometry x="40" y="1200" width="2280" height="330" as="geometry" />
        </mxCell>

        <mxCell id="ke1" parent="1" edge="1" source="k-drive" target="k-567" value="pin 3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;strokeColor=#82b366;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke2" parent="1" edge="1" source="k-sw" target="k-567" value="pins 1 and 2, switched to GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0.2;entryY=0;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontColor=#b85450;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke3" parent="1" edge="1" source="k-ota" target="k-567" value="pin 5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.35;entryY=1;strokeWidth=3;strokeColor=#82b366;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke4" parent="1" edge="1" source="k-ct" target="k-567" value="pin 6  CT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=0;entryX=0.75;entryY=1;strokeWidth=3;strokeColor=#82b366;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke5" parent="1" edge="1" source="k-freqcv" target="k-ota" value="Iabc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#9673a6;strokeWidth=2;fontSize=11;fontColor=#9673a6;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke6" parent="1" edge="1" source="k-freqab" target="k-shift" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#9673a6;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke7" parent="1" edge="1" source="k-shift" target="k-ct" value="A / B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;fontColor=#9673a6;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke8" parent="1" edge="1" source="k-567" target="k-q" value="pin 8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;strokeColor=#82b366;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke9" parent="1" edge="1" source="k-q" target="k-qout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.25;entryX=0;entryY=0.5;strokeWidth=3;strokeColor=#82b366;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ke10" parent="1" edge="1" source="k-q" target="k-lock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.75;entryX=0;entryY=0.5;strokeColor=#9673a6;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3 - Control and CV" id="gwHwCtrlV7">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="c-title" parent="1" vertex="1" value="PAGE 3 &#183; CONTROL AND CV&#xa;The Pico never touches audio. It reads DC and writes DC: PWM out to the OTAs and muxes, muxed ADC back in." style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;">
          <mxGeometry x="40" y="30" width="1500" height="66" as="geometry" />
        </mxCell>

        <mxCell id="c-board" parent="1" vertex="1" value="CONTROL BOARD&#xa;bolts behind the drilled face&#xa;&#xa;6&#215; ALPS RK09K1130A5R  B10k lin&#xa;FREQ  GAIN  MIX  /  FIZZ  Q  VOL&#xa;2&#215; Alpha SF12011F soft-touch stomps&#xa;6&#215; WS2812B: sect A, B, C, tempo, bypass, gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="40" y="380" width="360" height="200" as="geometry" />
        </mxCell>

        <mxCell id="c-j10" parent="1" vertex="1" value="J10  &#183;  KEYED 2&#215;8 HEADER&#xa;ONLY DC CROSSES:&#xa;rails &#183; 6 pot wipers &#183; 2 stomps &#183; WS2812 data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;">
          <mxGeometry x="480" y="410" width="330" height="140" as="geometry" />
        </mxCell>

        <mxCell id="c-pico" parent="1" vertex="1" value="U20  RASPBERRY PI PICO&#xa;&#xa;GP0&#8211;8    PWM CVs (10k + 100n, ~160 Hz pole)&#xa;GP9       CVOUT_PWM&#xa;GP10&#8211;14 mux addresses&#xa;GP15     WS2812 data (via U22)&#xa;GP16&#8211;17 stomps&#xa;GP18&#8211;21 4067 address&#xa;GP22     spare&#xa;ADC0     16ch mux &#183; ADC1/2 CV1/CV2 direct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="900" y="330" width="420" height="300" as="geometry" />
        </mxCell>

        <mxCell id="c-mux" parent="1" vertex="1" value="U21  74HC4067  &#183;  16ch ADC MUX (3V3)&#xa;C0&#8211;5  pot wipers&#xa;C6     ENV_ADC  (tapped on page 1, right after the voicing filter)&#xa;C7     VA_SENSE&#xa;C8     LOCK_SENSE&#xa;C9&#8211;11 gate trims RV1&#8211;3 (THRESH / HOLD / FADE)&#xa;C12&#8211;15 grounded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="440" y="720" width="500" height="200" as="geometry" />
        </mxCell>

        <mxCell id="c-trims" parent="1" vertex="1" value="RV1 / RV2 / RV3  10k trims (3224W)&#xa;the &#34;inside the pedal&#34; gate controls&#xa;THRESH &#183; HOLD &#183; FADE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="40" y="760" width="340" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c-cvin" parent="1" vertex="1" value="CV IN &#215;2  (J3 / J4, switched tip)&#xa;100k series &#183; /3 divider (accepts ~10 V)&#xa;BAT54S rail clamps &#183; RC slew&#xa;to ADC1 / ADC2 direct (fast path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="960" y="1010" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="c-cvout" parent="1" vertex="1" value="CV OUT  (J6)&#xa;Pico PWM, 2-pole RC,&#xa;&#215;1.52 on the +5 V-capable VA op-amp&#xa;(0&#8211;3.3 V becomes 0&#8211;5 V), 1k, jack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1400" y="1010" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="c-cvs" parent="1" vertex="1" value="PWM CVs OUT  (GP0&#8211;GP8, each 10k + 100n)&#xa;&#xa;DIRT_CV            dirt gain VCA&#xa;FREQ_CV            567 timing OTA   (second RC pole)&#xa;MIX_WET_CV         wet VCA&#xa;MIX_DRY_CV         dry VCA&#xa;SVF_F_CV           filter cutoff, both integrator Iabc&#xa;SVF_Q_CV           damping VCA&#xa;GATE_VOL_CV        gate &#215; VOL VCA&#xa;BYPASS_CV          clean-bypass VCA&#xa;STARVE_CV          VDIRT servo (page 4), now starves the JFET too" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;spacing=12;">
          <mxGeometry x="1420" y="330" width="600" height="300" as="geometry" />
        </mxCell>

        <mxCell id="c-addr" parent="1" vertex="1" value="MUX ADDRESSES OUT  (GP10&#8211;GP14)&#xa;&#xa;FREQ_A / FREQ_B      U8 CD4052B, 567 timing cap&#xa;                                 level-shifted 3.3 V to V567 by Q2/Q3&#xa;FMODE_A / B / C      U13 CD4051B, filter mode&#xa;                                 level-shifted 3.3 V to VA by Q4/Q5/Q6&#xa;&#xa;Both shifters INVERT, so firmware flips the bits." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;spacing=12;">
          <mxGeometry x="1420" y="670" width="600" height="230" as="geometry" />
        </mxCell>

        <mxCell id="c-leds" parent="1" vertex="1" value="U22  74AHCT1G125&#xa;WS2812 data level shift on +5 V&#xa;(3.3 V is marginal for 5 V pixels)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="900" y="150" width="420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c-note" parent="1" vertex="1" value="WHAT THE FIRMWARE OWNS&#xa;&#xa;The pots are DC wipers, not audio pots, so every knob law lives in firmware and matches the plugin: the FREQ decade sweep, the MIX crossfade&#xa;ratios that reproduce the original R9 1M / R10 100k mixer, the gate threshold and fade, the per-range 4052 timing correction, and the whole&#xa;modulation matrix. The analog side only has to be linear and quiet. The shape of every control is software.&#xa;&#xa;REV 7 FIRMWARE NOTE: with the supply fixed at 9 V, VA_SENSE no longer has to span 9 to 18 V. Rescale the divider for 9 V so the ADC spends all&#xa;its resolution on the range that can actually occur, and keep the reading as a sanity check on the adapter rather than as a CV-law input." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=12;">
          <mxGeometry x="2080" y="330" width="660" height="470" as="geometry" />
        </mxCell>

        <mxCell id="ce1" parent="1" edge="1" source="c-board" target="c-j10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" parent="1" edge="1" source="c-j10" target="c-pico" value="stomps &#183; WS2812" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3" parent="1" edge="1" source="c-j10" target="c-mux" value="6 wipers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=3;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce4" parent="1" edge="1" source="c-trims" target="c-mux" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce5" parent="1" edge="1" source="c-mux" target="c-pico" value="ADC0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0.25;entryY=1;strokeWidth=3;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce6" parent="1" edge="1" source="c-cvin" target="c-pico" value="ADC1 / ADC2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.6;entryY=1;strokeWidth=2;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce7" parent="1" edge="1" source="c-pico" target="c-cvout" value="CVOUT_PWM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.85;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce8" parent="1" edge="1" source="c-pico" target="c-cvs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;strokeColor=#9673a6;strokeWidth=3;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce9" parent="1" edge="1" source="c-pico" target="c-addr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.85;entryX=0;entryY=0.3;strokeColor=#9673a6;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="585" /><mxPoint x="1370" y="739" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="ce10" parent="1" edge="1" source="c-pico" target="c-leds" value="GP15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeWidth=2;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce11" parent="1" edge="1" source="c-leds" target="c-j10" value="to the 6 pixels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;strokeWidth=2;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="4 - Power" id="gwHwPowerV7">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p-title" parent="1" vertex="1" value="PAGE 4 &#183; POWER TREE  (rev 7: 9 V only)&#xa;The 78L09 is gone. At 9 V in it was in dropout and no longer regulating, so the 567 now runs straight off VA through a divider that caps it at 8.7 V." style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;">
          <mxGeometry x="40" y="30" width="1800" height="66" as="geometry" />
        </mxCell>

        <mxCell id="p-j5" parent="1" vertex="1" value="J5  DC JACK  2.1 mm&#xa;CENTRE-NEGATIVE&#xa;tip = GND, sleeve = +V&#xa;9 V DC ONLY  (rev 7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;">
          <mxGeometry x="40" y="400" width="260" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p-prot" parent="1" vertex="1" value="REVERSE PROTECT + FILTER&#xa;Q10 AO3401A P-FET&#xa;FB100 600R / 3A ferrite&#xa;D106 transient clamp&#xa;(SMAJ18A can drop to SMAJ12A now)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="360" y="400" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p-va" parent="1" vertex="1" value="VA  &#183;  RAW ANALOG RAIL  =  9 V&#xa;feeds every TL074 and LM13700" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="720" y="400" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p-vref" parent="1" vertex="1" value="VREF  =  VA / 2  =  4.5 V&#xa;mid-rail, buffered&#xa;(R14 / R15 / C10 of the original)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1120" y="180" width="340" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p-v567" parent="1" vertex="1" value="V567  &#183;  LM567 RAIL  (rev 7: no regulator)&#xa;series 56R from VA, 1.6k to GND&#xa;8.70 V unloaded  &#183;  about 8.3 V at the 567&#39;s ~8 mA&#xa;roughly 13 mA total, well under the 9 V abs max" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="1120" y="360" width="440" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p-buck" parent="1" vertex="1" value="+5 V BUCK&#xa;U19 MP1584EN + L100 22&#181;H / 3A&#xa;feeds the WS2812 chain and,&#xa;through D90 SS14, the Pico VSYS&#xa;(easier duty cycle from 9 V than from 18 V)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1120" y="560" width="440" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p-3v3" parent="1" vertex="1" value="3V3&#xa;from the Pico&#39;s own regulator&#xa;ADC reference, muxes, logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1640" y="560" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p-starve" parent="1" vertex="1" value="VDIRT  &#183;  STARVE SERVO&#xa;STARVE_CV (Pico PWM 0&#8211;3.3 V) &#215;5.45&#xa;commands Q11 BCP56&#xa;D103 6V2 zener floor = 5.0 V at the emitter&#xa;&#xa;REV 7: FEEDS THE JFET DRAIN *AND*&#xa;THE BAZZ FUSS COLLECTOR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="1120" y="780" width="460" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p-starvecv" parent="1" vertex="1" value="STARVE_CV&#xa;from the Pico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="300" y="830" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p-loads" parent="1" vertex="1" value="to the JFET drain and&#xa;the Bazz Fuss collector&#xa;(page 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="1680" y="820" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p-sense" parent="1" vertex="1" value="VA_SENSE&#xa;rev 7: rescale the divider for 9 V&#xa;(the old 18 V mapping wastes ADC range)&#xa;to ADC mux ch7 as an adapter sanity check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="620" y="1050" width="400" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p-note" parent="1" vertex="1" value="THE ONE THING TO WATCH ON THE NEW V567 RAIL&#xa;&#xa;A divider is RATIOMETRIC, not a clamp. It holds V567 at 0.966 &#215; VA, so it only caps at 8.7 V while VA is exactly 9.0 V. A 9 V adapter running +5 % puts VA at 9.45 V&#xa;and V567 lands near 8.8 V at load, and closer to 9.1 V if the 567 is drawing at the low end of its range. That is at or just past the LM567C 9 V absolute maximum.&#xa;&#xa;Three ways to make it an actual ceiling, cheapest first:&#xa;&#xa;  a)  Add a BZX84C8V2 across the shunt leg. The divider does the work at nominal, the zener catches the adapter tolerance. One extra part.&#xa;  b)  Keep D105. A series 1N4148 drops about 0.65 V almost independently of VA, so it tracks far better than a divider does. You already have the part in the BOM.&#xa;  c)  Both. Series diode for the bulk drop, small shunt for stiffness.&#xa;&#xa;STARVE IS STILL NOT A BROWN-OUT OF THE WHOLE PEDAL&#xa;&#xa;Only VDIRT sags. The op-amps, the 567 and everything digital stay on their own rails, so the pedal keeps working while the dirt side dies. Rev 7 just gives that&#xa;death spiral a second stage: the JFET loses headroom and rebiases while the fuss is already gating.&#xa;&#xa;COMP / FREQ / FB values around the MP1584 are still flagged for a datasheet check at the review pass." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=12;">
          <mxGeometry x="40" y="1250" width="2600" height="430" as="geometry" />
        </mxCell>

        <mxCell id="pe1" parent="1" edge="1" source="p-j5" target="p-prot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe2" parent="1" edge="1" source="p-prot" target="p-va" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe3" parent="1" edge="1" source="p-va" target="p-vref" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe4" parent="1" edge="1" source="p-va" target="p-v567" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe5" parent="1" edge="1" source="p-va" target="p-buck" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe6" parent="1" edge="1" source="p-va" target="p-starve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.9;exitY=1;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#d79b00;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe7" parent="1" edge="1" source="p-buck" target="p-3v3" value="Pico VSYS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe8" parent="1" edge="1" source="p-starvecv" target="p-starve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.85;strokeColor=#9673a6;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe9" parent="1" edge="1" source="p-va" target="p-sense" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=0.15;exitY=1;entryX=0.5;entryY=0;strokeColor=#9673a6;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe10" parent="1" edge="1" source="p-starve" target="p-loads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;strokeColor=#d79b00;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
