        <mxCell id="a-dryvca" parent="1" vertex="1" value="DRY VCA  U10B&#xa;Bazz Fuss output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="2320" y="795" width="230" height="120" as="geometry" />
