        <mxCell id="ae34" parent="1" edge="1" source="a-bell" target="a-gatevca" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae35" parent="1" edge="1" source="a-gatecv" target="a-gatevca" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#9673a6;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
