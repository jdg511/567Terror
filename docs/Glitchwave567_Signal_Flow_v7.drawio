        <mxCell id="a-drycv" parent="1" vertex="1" value="MIX_DRY_CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="2355" y="700" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a-sum" parent="1" vertex="1" value="U9A  VIRTUAL-GROUND SUM&#xa;the two VCA output CURRENTS sum here&#xa;(free mixing, no crossfade pot)&#xa;original R9 1M wet / R10 100k dry / R11 100k fb&#xa;reproduced by input attenuators + firmware CV law" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="2620" y="420" width="330" height="150" as="geometry" />
        </mxCell>

        <mxCell id="a-svf" parent="1" vertex="1" value="STATE-VARIABLE FILTER&#xa;LM13700 datasheet topology&#xa;U9B sum, U11A int1 (BP), U11B int2 (LP)&#xa;HP taken at the sum node&#xa;cutoff: SVF_F_CV into both Iabc&#xa;Q: BP feedback through U12A VCA, 0.25 to 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="3010" y="410" width="340" height="170" as="geometry" />
        </mxCell>

        <mxCell id="a-svfcv" parent="1" vertex="1" value="SVF_F_CV   &#183;   SVF_Q_CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="3070" y="600" width="220" height="42" as="geometry" />
        </mxCell>

        <mxCell id="a-fmode" parent="1" vertex="1" value="U13  CD4051B&#xa;MODE SELECT&#xa;ch0 Off (bypass) &#183; ch1 LP&#xa;ch2 BP &#183; ch3 HP &#183; ch4 Notch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="3410" y="420" width="250" height="150" as="geometry" />
        </mxCell>

        <mxCell id="a-fmodecv" parent="1" vertex="1" value="FMODE_A / B / C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="3450" y="600" width="170" height="42" as="geometry" />
        </mxCell>

        <!-- ===== output ===== -->
        <mxCell id="a-outhdr" parent="1" vertex="1" value="OUTPUT CHAIN  (rev 7: the ladder and the +6 dB boost are gone, so this is now just voicing then level)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;">
          <mxGeometry x="40" y="1020" width="1100" height="26" as="geometry" />
