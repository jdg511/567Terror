<mxfile host="Electron" agent="Claude">
  <diagram name="1 - Audio Path" id="gwHwAudioV7">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3720" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="a-title" parent="1" vertex="1" value="GLITCHWAVE 567 &#183; MAIN BOARD HARDWARE SIGNAL FLOW  (rev 7)&#xa;Page 1 of 4: the audio path. Every knob is an OTA VCA driven by a Pico PWM CV, so no audio ever touches the MCU." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;">
          <mxGeometry x="40" y="26" width="1700" height="66" as="geometry" />
        </mxCell>

        <mxCell id="a-rev" parent="1" vertex="1" value="REV 7 CHANGES:  9 V only (12/15/18 V dropped)  &#183;  &#8722;3/&#8722;6 ladder and +6 dB boost removed  &#183;  JFET moved out of the output chain to sit in front of the Bazz Fuss, still on its own switch, now on the VDIRT rail so STARVE reaches it&#xa;&#183;  C41 / C42 are now fitted with switches instead of DNP pads, both shipping OFF  &#183;  envelope follower is now explicitly the first tap after the voicing filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry x="40" y="100" width="1700" height="66" as="geometry" />
        </mxCell>

        <mxCell id="a-legend" parent="1" vertex="1" value="Blue = op-amp / passive audio   &#183;   Green = wet (567)   &#183;   Orange = dry (Bazz Fuss)   &#183;   Purple = CV from the Pico   &#183;   Red = switch   &#183;   Yellow = jacks and rails" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;">
          <mxGeometry x="1960" y="36" width="1500" height="28" as="geometry" />
        </mxCell>

        <!-- ===== input ===== -->
        <mxCell id="a-j1" parent="1" vertex="1" value="J1  INPUT JACK&#xa;6.35 mm PJ-603A&#xa;switched tip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;">
          <mxGeometry x="40" y="400" width="180" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-innet" parent="1" vertex="1" value="INPUT NETWORK  (original, faithful)&#xa;R1 1k series &#183; R2 2.2M load&#xa;C1 220n block &#183; R3 2.2M bias to VREF&#xa;then U1A buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="260" y="400" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-voice" parent="1" vertex="1" value="VOICING LOW-CUT&#xa;2&#215; Sallen-Key HP, 24 dB/oct @ 40 Hz&#xa;Q 0.54 then Q 1.31" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="590" y="400" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-tap" parent="1" vertex="1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;">
          <mxGeometry x="892" y="452" width="16" height="16" as="geometry" />
        </mxCell>

        <mxCell id="a-taplbl" parent="1" vertex="1" value="DRY_CLEAN" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;">
          <mxGeometry x="830" y="524" width="140" height="24" as="geometry" />
        </mxCell>

        <mxCell id="a-env" parent="1" vertex="1" value="ENVELOPE FOLLOWER  (rev 7: measured HERE)&#xa;first thing off the voicing filter, before any gain,&#xa;dirt or 567 has touched the signal&#xa;precision full-wave rectifier, VREF-referenced&#xa;Mu-Tron ballistics: attack ~4 ms, release ~150 ms&#xa;buffered, divided to 0&#8211;3.3 V, BAT54 clamp, to ADC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="950" y="380" width="360" height="160" as="geometry" />
        </mxCell>

        <mxCell id="a-envout" parent="1" vertex="1" value="ENV_ADC&#xa;to ADC mux ch6 (page 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="1000" y="570" width="260" height="56" as="geometry" />
        </mxCell>

        <!-- ===== wet branch ===== -->
        <mxCell id="a-trim" parent="1" vertex="1" value="FIXED TRIM&#xa;+15 dB&#xa;wet branch only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1000" y="200" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-gain" parent="1" vertex="1" value="GAIN STAGE  U1&#xa;&#215;214.6  (1 + 470k / 2.2k)&#xa;C2 4.7&#181; shelf, unity below 15.4 Hz&#xa;CLIPS THE RAILS, square into the 567" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1230" y="200" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-567" parent="1" vertex="1" value="U5  LM567  TONE DECODER&#xa;SO-8, on the V567 rail&#xa;THE HEART&#xa;detail on page 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="1570" y="190" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="a-sw" parent="1" vertex="1" value="SW2 / SW3  (rev 7, NEW)&#xa;C41 1&#181; on LFIL pin 2  &#183;  C42 220n on OFIL pin 1&#xa;BOTH SHIP OFF, which is the voice.&#xa;Switch sits on the GROUND side of each cap." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="1540" y="20" width="360" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-freqota" parent="1" vertex="1" value="U7  LM13700 OTA&#xa;emulates the timing resistor RT&#xa;pin 5 square, attenuator, OTA,&#xa;current into the CT node&#xa;R38 100k floor keeps the VCO alive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1450" y="560" width="290" height="130" as="geometry" />
        </mxCell>

        <mxCell id="a-ctmux" parent="1" vertex="1" value="U8  CD4052B&#xa;CT RANGE SELECT&#xa;47n / 1&#181; / 22&#181; / 470&#181;&#xa;with the OTA sweep: 0.2 Hz to 6 kHz+" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1790" y="560" width="270" height="130" as="geometry" />
        </mxCell>

        <mxCell id="a-freqcv" parent="1" vertex="1" value="FREQ_CV (Iabc)   &#183;   FREQ_A / FREQ_B (range)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="1560" y="706" width="400" height="42" as="geometry" />
        </mxCell>

        <mxCell id="a-q" parent="1" vertex="1" value="Q OPEN-COLLECTOR NODE  (pin 8)&#xa;R16 100k weak pull-up to V567&#xa;C43 makes the stray C explicit&#xa;lopsided square, original behaviour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1930" y="200" width="300" height="120" as="geometry" />
        </mxCell>

        <!-- ===== dirt branch ===== -->
        <mxCell id="a-dirtvca" parent="1" vertex="1" value="DIRT GAIN VCA  U3 LM13700&#xa;&#215;1 to &#215;300 sweep&#xa;(VCA attenuator + fixed &#215;300 stage)&#xa;replaces a digipot: 5 V parts cannot&#xa;pass 9 V-referenced audio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1000" y="780" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="a-dirtcv" parent="1" vertex="1" value="DIRT_CV (Iabc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="1060" y="950" width="180" height="42" as="geometry" />
        </mxCell>

        <mxCell id="a-jfet" parent="1" vertex="1" value="JFET STAGE  QJ1 MMBFJ201  (rev 7: MOVED HERE)&#xa;Fetzer Valve, biased at half pinch-off&#xa;SW1 selects JFET or straight through&#xa;ALWAYS-ON COLOUR: at the bottom of the GAIN sweep the&#xa;path is unity but the JFET is still curving, so there is a&#xa;little tube-ish grit even with the knob down&#xa;DRAIN RAIL = VDIRT, so STARVE reaches it: as the rail sags&#xa;toward the 5 V floor the bias walks down and it squishes, then dies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=3;">
          <mxGeometry x="1350" y="770" width="400" height="170" as="geometry" />
        </mxCell>

        <mxCell id="a-bazz" parent="1" vertex="1" value="BAZZ FUSS  (always on)&#xa;Q1 MMBTA13 darlington + D1 diode&#xa;collector rail = VDIRT (same starve target)&#xa;9 kHz voicing LP, DC-blocked out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1780" y="780" width="320" height="150" as="geometry" />
        </mxCell>

        <mxCell id="a-vdirt" parent="1" vertex="1" value="VDIRT  (page 4)&#xa;starve servo rail, 9 V down to a 5 V floor&#xa;now feeds BOTH the JFET drain and the Bazz Fuss collector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="1420" y="990" width="500" height="90" as="geometry" />
        </mxCell>

        <!-- ===== mix ===== -->
        <mxCell id="a-wetvca" parent="1" vertex="1" value="WET VCA  U10A&#xa;raw 567 square" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="2320" y="200" width="230" height="120" as="geometry" />
