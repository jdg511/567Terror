        <mxCell id="a-wetcv" parent="1" vertex="1" value="MIX_WET_CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="2355" y="340" width="160" height="40" as="geometry" />
