        <mxCell id="ae26" parent="1" edge="1" source="a-dryvca" target="a-sum" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;strokeWidth=3;strokeColor=#d79b00;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ae27" parent="1" edge="1" source="a-sum" target="a-svf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;"><mxGeometry relative="1" as="geometry" /></mxCell>
