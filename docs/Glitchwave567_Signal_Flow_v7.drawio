        <mxCell id="a-dcblk" parent="1" vertex="1" value="C8 / R12 DC BLOCK&#xa;7.2 Hz (original)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="40" y="1060" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-hp60" parent="1" vertex="1" value="HP 60 Hz&#xa;12 dB/oct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="300" y="1060" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-bell" parent="1" vertex="1" value="BELL +3 dB @ 800 Hz&#xa;Q 0.5 &#183; Zf 3.6k||56n, Zg 4.3k+47n&#xa;review-verified 790 Hz / +3.04 dB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="520" y="1060" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-gatevca" parent="1" vertex="1" value="U15A  GATE &#215; VOL VCA&#xa;one VCA, product CV from the Pico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="840" y="1060" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-gatecv" parent="1" vertex="1" value="GATE_VOL_CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="890" y="1190" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a-bypvca" parent="1" vertex="1" value="U15B  CLEAN-BYPASS VCA&#xa;fed from DRY_CLEAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="840" y="1300" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-bypcv" parent="1" vertex="1" value="BYPASS_CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="890" y="1430" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a-dryin" parent="1" vertex="1" value="DRY_CLEAN&#xa;(global label, from the input tap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;dashed=1;">
          <mxGeometry x="530" y="1315" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a-obuf" parent="1" vertex="1" value="U16A  SUM + BUFFER&#xa;U15A and U15B output CURRENTS&#xa;sum here (ERC output-output waiver)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1170" y="1175" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a-r13" parent="1" vertex="1" value="R13&#xa;470R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;">
          <mxGeometry x="1520" y="1180" width="120" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-j2" parent="1" vertex="1" value="J2  OUTPUT JACK&#xa;6.35 mm PJ-603A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;">
          <mxGeometry x="1690" y="1180" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="a-note" parent="1" vertex="1" value="WHAT MOVING THE JFET ACTUALLY DOES&#xa;&#xa;At the output the JFET was the last shaping stage, so you heard its asymmetry directly on the finished sound. In front of a Bazz Fuss you mostly hear it as a change in&#xa;how the fuss is DRIVEN: its squish sets where the darlington starts gating, so the effect shows up as a shift in the fuss&#39;s attack and velcro rather than as its own timbre.&#xa;&#xa;The payoff is that STARVE now collapses two stages instead of one. Both the JFET drain and the Bazz Fuss collector hang off VDIRT, so as the rail walks down toward the&#xa;5 V floor the JFET loses headroom and rebiases while the fuss is already gating. The death spiral gets a second stage in it.&#xa;&#xa;THE ALWAYS-ON GRIT, AND THE ONE THING TO WATCH&#xa;&#xa;The dirt VCA sets the level going INTO the JFET, so at the bottom of the GAIN sweep the stage sees a bare guitar signal and contributes only its own mild asymmetric&#xa;curvature. That is the point: knob down is clean-ish but never sterile. As GAIN climbs, the JFET gets slammed and its character is progressively swamped by the fuss.&#xa;&#xa;Watch the level, though. A Fetzer Valve at 9 V is not unity, it is roughly &#215;4 to &#215;10 of voltage gain, so &#34;GAIN at minimum&#34; is only unity THROUGH THE PATH if something&#xa;gives that back. Either degenerate the source resistor for about unity and let the curvature come from bias rather than swing, or let the VCA sit below unity at the&#xa;bottom of its law and calibrate the knob so the audible result is level-matched. Worth settling on the breadboard before the values go in.&#xa;&#xa;WHY THE C41 / C42 SWITCHES SIT ON THE GROUND SIDE&#xa;&#xa;Put the switch between the cap and ground, not between the cap and the pin. LFIL and OFIL are high-impedance nodes, so a switch stub hanging off the pin adds stray C&#xa;straight onto the thing you are trying to leave alone. On the ground side, OFF leaves the cap&#39;s far plate floating and the pin sees your cap in series with a few pF, which is&#xa;nothing. Add roughly 1M across each switch so the floating plate cannot drift and thump when you flip it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=12;">
          <mxGeometry x="2000" y="1020" width="1660" height="380" as="geometry" />
        </mxCell>

        <!-- ===== edges ===== -->
        <mxCell id="ae1" parent="1" edge="1" source="a-j1" target="a-innet" value="IN_TIP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;fontSize=11;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" parent="1" edge="1" source="a-innet" target="a-voice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" parent="1" edge="1" source="a-voice" target="a-tap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;endArrow=none;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae4" parent="1" edge="1" source="a-tap" target="a-env" value="FIRST TAP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;fontSize=11;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae5" parent="1" edge="1" source="a-env" target="a-envout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#9673a6;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae6" parent="1" edge="1" source="a-tap" target="a-trim" value="V567_DRIVE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;strokeWidth=3;strokeColor=#82b366;fontSize=11;fontColor=#82b366;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae7" parent="1" edge="1" source="a-tap" target="a-dirtvca" value="DRY_CLEAN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;strokeWidth=3;strokeColor=#d79b00;fontSize=11;fontColor=#d79b00;"><mxGeometry relative="1" as="geometry" /></mxCell>

