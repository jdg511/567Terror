        <mxCell id="ae37" parent="1" edge="1" source="a-dryin" target="a-bypvca" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;strokeColor=#d79b00;"><mxGeometry relative="1" as="geometry" /></mxCell>
