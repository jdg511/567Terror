        <mxCell id="pe6" parent="1" edge="1" source="p-c41" target="p-vco" value="steers the oscillator" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeWidth=2;strokeColor=#82b366;fontSize=11;fontColor=#82b366;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="225" /><mxPoint x="1450" y="525" /></Array></mxGeometry></mxCell>
