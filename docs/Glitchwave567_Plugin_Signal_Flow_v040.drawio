        <mxCell id="pe2" parent="1" edge="1" source="p-c3" target="p-comp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#82b366;"><mxGeometry relative="1" as="geometry" /></mxCell>
