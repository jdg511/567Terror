<mxfile host="app.diagrams.net"><diagram id="wtf-flow" name="Signal flow v0.60"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Where The Fuzz Meets The Funk  |  Illicit Apothecary  |  signal flow, plugin v0.60" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="-30" width="900" height="30" as="geometry"/></mxCell><mxCell id="n3" value="MODULATION (per-sample ticks, knob values recomputed each chunk)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Sidechain In 1 (CV1 jack). Bus off by default; connected = plugged" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="160" height="50" as="geometry"/></mxCell><mxCell id="n5" value="Sidechain In 2 (CV2 jack). Mono sidechain feeds both CV1 and CV2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="160" height="50" as="geometry"/></mxCell><mxCell id="n6" value="CV1: |x| smoothed 15 ms. Plugged: VCA on LFO1 depth (silent = 0). Unplugged: depth full, no fallback logic" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="230" y="40" width="200" height="50" as="geometry"/></mxCell><mxCell id="n7" value="CV2: |x| smoothed 15 ms. Plugged: this is the audio the envelope follower follows (silent = dead)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="230" y="120" width="200" height="50" as="geometry"/></mxCell><mxCell id="n8" value="LFO 1 (shape, rate, depth x CV1), unipolar" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="40" width="190" height="50" as="geometry"/></mxCell><mxCell id="n9" value="LFO 2 (shape, rate, depth), bipolar. Not driven by CV2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="190" height="50" as="geometry"/></mxCell><mxCell id="n10" value="Rectify: CV2 if plugged, else RAW INPUT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="230" y="230" width="150" height="50" as="geometry"/></mxCell><mxCell id="n11" value="Envelope cap: attack 1.55 ms, decay 158.7 ms (ATTACK / DECAY knobs)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="230" width="190" height="60" as="geometry"/></mxCell><mxCell id="n12" value="Vactrol lag: 2.5 ms on, 35 ms off" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="630" y="230" width="160" height="50" as="geometry"/></mxCell><mxCell id="n13" value="THRESHOLD, RATIO, SHAPE, then Mu-Tron vactrol law" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="230" width="190" height="60" as="geometry"/></mxCell><mxCell id="n14" value="x ENV GAIN (and x LFO1 level if targeted)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1040" y="230" width="170" height="60" as="geometry"/></mxCell><mxCell id="n15" value="Front-panel knobs (base values): FREQ, FIZZ, LPF Q, MIX, VOL, GAIN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="10" width="230" height="60" as="geometry"/></mxCell><mxCell id="n16" value="Modulation targets (LFO1, LFO2, ENV each pick one): a knob, LFO1 rate/depth, ENV amount/level" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="n17" value="Gate pull: FREQ and FIZZ x (1 - pull)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1520" y="110" width="180" height="60" as="geometry"/></mxCell><mxCell id="n18" value="Wtf567 params (freq, fizz, Q, mix, vol, gain, stomps, STARVE)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1740" y="110" width="200" height="60" as="geometry"/></mxCell><mxCell id="n19" value="Gate follower: |raw input|, 10 ms" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="410" y="340" width="170" height="50" as="geometry"/></mxCell><mxCell id="n20" value="Gate THRESH / HOLD / FADE -&gt; attenuation dB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="610" y="340" width="190" height="50" as="geometry"/></mxCell><mxCell id="n21" value="AUDIO PATH" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="300" height="24" as="geometry"/></mxCell><mxCell id="n22" value="Host input (all channels summed to mono)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="170" height="60" as="geometry"/></mxCell><mxCell id="n23" value="Audio Player 1 (demo clip, level knob, play/stop)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="170" height="60" as="geometry"/></mxCell><mxCell id="n24" value="Mono sum" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="110" height="50" as="geometry"/></mxCell><mxCell id="n25" value="RAW INPUT COPY (liveIn)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="470" width="150" height="50" as="geometry"/></mxCell><mxCell id="n26" value="Input meter" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="150" height="40" as="geometry"/></mxCell><mxCell id="n27" value="Oversample up" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="560" y="470" width="130" height="50" as="geometry"/></mxCell><mxCell id="n28" value="Jack network: x jack volts, C1 DC block 0.33 Hz, 24 dB/oct high-pass 40 Hz" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="720" y="460" width="200" height="70" as="geometry"/></mxCell><mxCell id="n29" value="Input buffer U1.1 (clips at op-amp rail) = clean DRY tap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="950" y="460" width="190" height="70" as="geometry"/></mxCell><mxCell id="n30" value="LM567 BRANCH (wet)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="610" width="300" height="22" as="geometry"/></mxCell><mxCell id="n31" value="+15 dB fixed trim (wet only)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="720" y="635" width="140" height="60" as="geometry"/></mxCell><mxCell id="n32" value="Gain stage U1.3 (+46.6 dB, clips to rails)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="890" y="635" width="150" height="60" as="geometry"/></mxCell><mxCell id="n33" value="C3 high-pass 36 Hz + noise floor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1070" y="635" width="150" height="60" as="geometry"/></mxCell><mxCell id="n34" value="Input limiter / comparator (hysteresis)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1250" y="635" width="150" height="60" as="geometry"/></mxCell><mxCell id="n35" value="VCO (FREQ) + phase detector, loop filter (C41 optional)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1430" y="635" width="170" height="60" as="geometry"/></mxCell><mxCell id="n36" value="Quadrature lock detector (C42 optional) + comparator; deaf below 4.75 V" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1630" y="635" width="190" height="70" as="geometry"/></mxCell><mxCell id="n37" value="Q open-collector node (R16 pull-up) x stomp B (decoder on/off)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1850" y="635" width="190" height="70" as="geometry"/></mxCell><mxCell id="n38" value="FUZZ BRANCH (dry)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="745" width="300" height="22" as="geometry"/></mxCell><mxCell id="n39" value="Stomp A: fuzz on/off (off = clean buffer to mixer)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="950" y="770" width="170" height="60" as="geometry"/></mxCell><mxCell id="n40" value="J201 JFET Fetzer (SW1, ships OUT), drain on VDIRT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1150" y="770" width="180" height="60" as="geometry"/></mxCell><mxCell id="n41" value="Bazz Fuss dirt (GAIN knob, bias sag)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1360" y="770" width="170" height="60" as="geometry"/></mxCell><mxCell id="n42" value="Parallel MIX: -(wet x Q + dry x fuzz), op-amp clip" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2070" y="720" width="190" height="70" as="geometry"/></mxCell><mxCell id="n43" value="Envelope filter, stomp C: Off / LP / BP / HP / Notch, FIZZ cutoff, Q, Lo/Hi range" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2070" y="830" width="200" height="80" as="geometry"/></mxCell><mxCell id="n44" value="Output voicing: C8 DC block 7.2 Hz, high-pass 60 Hz, +3 dB bell at 800 Hz" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2070" y="570" width="200" height="80" as="geometry"/></mxCell><mxCell id="n45" value="Rail clip (ceiling = VA / 9), / jack volts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2070" y="440" width="200" height="60" as="geometry"/></mxCell><mxCell id="n46" value="OUTPUT" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="345" width="200" height="22" as="geometry"/></mxCell><mxCell id="n47" value="Oversample down" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1860" y="380" width="150" height="50" as="geometry"/></mxCell><mxCell id="n48" value="Gate gain ramp" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="380" width="150" height="50" as="geometry"/></mxCell><mxCell id="n49" value="Output meter" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1640" y="300" width="150" height="40" as="geometry"/></mxCell><mxCell id="n50" value="Bypass crossfade (10 ms) against RAW INPUT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1400" y="380" width="190" height="50" as="geometry"/></mxCell><mxCell id="n51" value="Host output (mono copied to all channels)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1180" y="380" width="170" height="50" as="geometry"/></mxCell><mxCell id="n52" value="POWER MODEL: VA = 9 V; STARVE sags it linearly to 1 V. Op-amp rail = VA/2 - 1.4 V, VREF = VA/2, clip ceiling = VA/9. LM567 rail = LM2937-8.0 (8.0 V, 0.15 V dropout, hardware plan, sim v0.56+). LM567 goes deaf below 4.75 V." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="300" height="190" as="geometry"/></mxCell><mxCell id="e53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded