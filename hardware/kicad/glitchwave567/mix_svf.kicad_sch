  (text "NOTE: U10A+U10B outputs tied = OTA CURRENT summing (intentional; ERC output-output waiver)."
    (at 25.4 33.02 0)
    (effects (font (size 1.5 1.5)))
    (uuid e0ed063b-0d66-409b-a2c3-cca6b3dc2d22)
  )
  (text "MIX crossfade: WET (raw 567 square) and DRY (Bazz Fuss) each through a VCA; output CURRENTS sum at U9A virtual ground (free mixing)."
    (at 25.4 25.4 0)
    (effects (font (size 1.8 1.8)))
    (uuid f8e8c825-4f5f-4ef5-b1ad-9d418d5bf2c1)
  )
  (text "Original mixer ratios (R9 1M wet / R10 100k dry / R11 100k fb) are reproduced by the input attenuators + firmware CV law."
    (at 25.4 29.21 0)
    (effects (font (size 1.8 1.8)))
    (uuid bed0f7dc-ae03-47c6-bd04-39da8541f03e)
  )
  (text "SVF (LM13700 datasheet topology): U9B input sum -> U11A int1 (BP) -> U11B int2 (LP); HP at the sum node. Cutoff = SVF_F_CV -> both Iabc."
    (at 25.4 106.68 0)
    (effects (font (size 1.8 1.8)))
    (uuid 5f3ea414-bba9-4070-92b0-f91f6869a4ef)
  )
  (text "Q: damping BP feedback passes through U12A VCA -> SVF_Q_CV sets resonance 0.25..8 continuously (synth-style)."
    (at 25.4 110.49 0)
    (effects (font (size 1.8 1.8)))
    (uuid 2f7ad142-c469-424c-a833-e3542fda565f)
  )
  (text "Mode select: CD4051B on VA rail. ch0=Off(bypass) ch1=LP ch2=BP ch3=HP ch4=Notch. Address 3.3V->VA level-shifted (inverting)."
    (at 154.94 178.0 0)
    (effects (font (size 1.8 1.8)))
    (uuid 3d8cd8cf-31f5-4c75-ab94-7c3cdedf03a5)
  )

